# ─── Backend environment template ────────────────────────────────────────────
# Copy to backend/.env and fill in real values. NEVER commit the real file.
# If a key was ever exposed (e.g. committed to git), ROTATE it in the provider dashboard.

PORT=5000
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ─── CORS / URLs ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://isp-click-opticx.web.app
FRONTEND_URL=http://localhost:5173

# ─── Supabase (Project Settings → API) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# NOTE: config-manager also accepts SUPABASE_SERVICE_KEY as a legacy alias
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (Resend primary, Gmail SMTP fallback) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_DOMAIN=clickopticx.com
EMAIL_FROM_NAME=Click Opticx
EMAIL_FROM_ADDRESS=no-reply@clickopticx.com
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ─── Redis / Queue (Upstash REST) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# ─── Firebase Admin (service account JSON, single line) ──────────────────────
FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
FIREBASE_MODE=readonly

# ─── Migration control ───────────────────────────────────────────────────────
DUAL_WRITE_ENABLED=false
PRIMARY_SOURCE=supabase
